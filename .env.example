NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/thechat
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=development-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WS_PATH=/ws
WS_MAX_PAYLOAD_BYTES=65536
WS_HEARTBEAT_INTERVAL_MS=30000
WS_REALTIME_CHANNEL=thechat:realtime:events
PRESENCE_CONNECTION_TTL_SECONDS=90
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=the_chat_server_code_rag
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_FILE_BYTES=262144
